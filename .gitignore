# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
.output
.vinxi
.tanstack/**
.nitro
*.local

# Environment variables — never commit real secrets
.env
.env.local
.env.*.local
# Vite mode-specific env files outrank .env for their build mode — a
# committed one can silently diverge from .env with nobody noticing
# (see src/lib/envConsistency.ts's MODE_ENV_FILES / the test that caught
# a committed .env.development in the wild).
.env.development
.env.production
.env.test

# Wrangler / Cloudflare
.wrangler/
.dev.vars

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.claude/
